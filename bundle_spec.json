{
  "id": "transformers-pro",
  "name": "Transformers Pro 1.80 (Stern 2011), MPF recreation",
  "game_dir": "game",
  "git_tracked": [
    "game",
    "scripts"
  ],
  "git_exclude": [
    "game/addons/"
  ],
  "copy": [
    "game/config/rom",
    "game/sounds",
    "game/media",
    "game/fonts",
    "rom/rom_data/io",
    "rom/rom_data/sound",
    "rom/rom_data/settings",
    "rom/mpf_package/config",
    "rom/mpf_package/event_map.csv",
    "rom/mpf_package/service_menu.json",
    "rom/mpf_package/media/rom_images_all.zip",
    "rom/rules/traces"
  ],
  "never": [
    "game/data",
    "game/audits",
    "game/logs",
    "game/pup.local.cfg",
    "pup_pack",
    "pup_media"
  ],
  "never_names": [
    "*.local.cfg",
    "*.bin",
    "tf_*.zip",
    "machine_vars.yaml"
  ],
  "platform_addons": [
    "gde_gozen"
  ],
  "precheck": [
    "python3",
    "scripts/package/build_bundle.py",
    "--check-only"
  ],
  "requires": {
    "python": ">=3.11",
    "programs": [
      "ffmpeg"
    ],
    "env": {
      "TF_PUP": "optional: 0 = strict ROM game (no PuP)"
    }
  },
  "run": {
    "start": "python3 scripts/run.py",
    "cwd": "."
  },
  "options": {
    "schema": "scripts/package/options.json"
  },
  "pup": {
    "install": "python3 scripts/pup_setup.py --pup-zip ZIP_PATH_OR_URL",
    "pack_dir": "pup_pack/tf_180",
    "needs_restart": true
  },
  "keep_on_update": [
    "game/data",
    "game/audits",
    "game/logs",
    "game/pup.local.cfg",
    "pup_pack",
    "pup_media"
  ],
  "import_seed": [
    {
      "dir": "game/media/dmd",
      "template": "scripts/package/dmd_frame.import.template"
    }
  ]
}
