{
  "groups": [
    {"id": "play", "label": "Play"},
    {"id": "display", "label": "Display"},
    {"id": "pup", "label": "PuP Pack (videos and music)"}
  ],
  "options": [
    {"id": "free_play", "group": "play", "label": "Free play", "type": "bool", "default": true,
     "help": "Off: the factory pricing, a coin is needed to start.",
     "target": {"flag": "--free-play", "flag_off": "--no-free-play"}, "restart": true},
    {"id": "dmd_size", "group": "display", "label": "DMD window size", "type": "size", "default": "1024x256",
     "help": "The 128x32 dots scaled to this size, in pixels (WIDTHxHEIGHT).",
     "target": {"arg": "--dmd-size"}, "restart": true},
    {"id": "pup.enabled", "group": "pup", "label": "PuP videos and music", "type": "bool", "default": true,
     "help": "Off: the strict ROM game, the ROM's music, no extra windows.",
     "target": {"cfg": "pup.local.cfg", "section": "pup", "key": "enabled"}, "restart": true},
    {"id": "pup.ost_music", "group": "pup", "label": "PuP music instead of the ROM's", "type": "bool", "default": true,
     "help": "Off: the ROM's music, the videos still play.",
     "target": {"cfg": "pup.local.cfg", "section": "pup", "key": "ost_music"}, "restart": true},
    {"id": "pup.third_screen", "group": "pup", "label": "Topper screen", "type": "bool", "default": true,
     "target": {"cfg": "pup.local.cfg", "section": "pup", "key": "third_screen"}, "restart": true},
    {"id": "pup.video_volume", "group": "pup", "label": "Video volume", "type": "integer", "min": 0, "max": 100, "default": 100, "unit": "%",
     "target": {"cfg": "pup.local.cfg", "section": "pup", "key": "video_volume"}, "restart": true},
    {"id": "pup.music_volume", "group": "pup", "label": "Music volume", "type": "integer", "min": 0, "max": 100, "default": 100, "unit": "%",
     "target": {"cfg": "pup.local.cfg", "section": "pup", "key": "music_volume"}, "restart": true},
    {"id": "pup.layout", "group": "pup", "label": "Window layout", "type": "choice", "choices": ["stack", "fullscreen"], "default": "stack",
     "help": "stack: the windows one under the other on the backglass's monitor. fullscreen: the backglass fills its monitor and the DMD fills a second one (a real DMD's LCD or another screen); DMD monitor 1 unless set below.",
     "target": {"cfg": "pup.local.cfg", "section": "pup", "key": "layout", "apply": {
       "stack": [["pup", "layout", "\"stack\""], ["backglass", "fullscreen", "false"], ["dmd", "fullscreen", "false"]],
       "fullscreen": [["pup", "layout", "\"manual\""], ["backglass", "fullscreen", "true"], ["dmd", "fullscreen", "true"]]},
       "default_if_unset": [["dmd", "screen", "1"]]}, "restart": true},
    {"id": "pup.backglass.screen", "group": "pup", "label": "Backglass monitor", "type": "integer", "min": 0, "max": 7, "default": 0,
     "target": {"cfg": "pup.local.cfg", "section": "backglass", "key": "screen"}, "restart": true},
    {"id": "pup.dmd.screen", "group": "pup", "label": "DMD monitor", "type": "integer", "min": 0, "max": 7, "default": 0,
     "help": "Monitor index of the DMD window (the fullscreen layout puts it on monitor 1 unless you set it here).",
     "target": {"cfg": "pup.local.cfg", "section": "dmd", "key": "screen"}, "restart": true},
    {"id": "pup.topper.screen", "group": "pup", "label": "Topper monitor", "type": "integer", "min": 0, "max": 7, "default": 0,
     "target": {"cfg": "pup.local.cfg", "section": "topper", "key": "screen"}, "restart": true}
  ]
}
